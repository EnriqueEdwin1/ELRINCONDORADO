@using ELRINCONDORADO.Models
@model IEnumerable<Pedido>

@{
    ViewData["Title"] = "Cola de Cocina";
    Layout = null;
    var nombre = Context.Session.GetString("Nombre");
    var rol = Context.Session.GetString("Rol");
    var hayPedidos = Model != null && Model.Any();
    var listos = hayPedidos ? Model.Count(p => p.Estado == "LISTO") : 0;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        :root {
            --dorado: #d4af37;
            --dorado-oscuro: #b8941e;
            --marron: #3e2723;
        }
        body {
            background: #f7f5ef;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .navbar {
            background: linear-gradient(135deg, #3e2723 0%, #6b3a2a 100%);
            box-shadow: 0 4px 14px rgba(62, 39, 35, 0.35);
        }
        .navbar-brand { font-weight: 800; font-size: 20px; color: #fff !important; letter-spacing: .5px; }
        .navbar-brand span { color: var(--dorado); }
        .btn-logout {
            background: var(--dorado); color: #fff; border: none; font-weight: 600;
            padding: 6px 18px; border-radius: 8px; transition: all .25s ease;
        }
        .btn-logout:hover { background: var(--dorado-oscuro); transform: translateY(-2px); }
        .container-custom { max-width: 1300px; margin: 0 auto; padding: 28px 15px; }
        .titulo-panel { font-weight: 800; color: var(--marron); display: flex; align-items: center; gap: 10px; }
        .titulo-panel small { color: #9c8b73; font-weight: 600; }
        .badge-cola { background: #f2e7c9; color: var(--marron); font-weight: 700; padding: 6px 14px; border-radius: 20px; }
        .badge-lista { background: #d5f0de; color: #1e7a45; font-weight: 700; padding: 6px 14px; border-radius: 20px; }
        .vacio-cocina {
            text-align: center; padding: 70px 20px; color: #9c8b73;
            border: 2px dashed #d9c9a3; border-radius: 16px; background: #fff;
        }
        .vacio-cocina .emblema { font-size: 56px; }
        .pedido-card {
            background: #fff; border-radius: 14px; box-shadow: 0 3px 12px rgba(0,0,0,.06);
            border-left: 6px solid var(--dorado); margin-bottom: 18px; overflow: hidden;
        }
        .pedido-card.urgente { border-left-color: #e67e22; }
        /* Pedido LISTO: se queda en la cola en verde hasta que el mesero lo marque ENTREGADO */
        .pedido-card.listo {
            background: #eafaf0; border-left-color: #27ae60;
            box-shadow: 0 3px 14px rgba(39,174,96,.18);
        }
        .pedido-card.listo .pedido-head { background: #dcf5e6; border-bottom-color: #bfe8d0; }
        .pedido-card.listo .pedido-num { color: #1e7a45; }
        .pedido-card.listo .prod-nombre { color: #1f6b40; }
        .pedido-card.listo .prod-cant { color: #1e8449; }
        .pedido-card.listo .prod-linea { border-bottom-color: #cdebd8; }
        .pedido-card.listo .pie-tiempo { background: #e0f6e9; border-top-color: #bfe8d0; color: #5f7f6c; }
        .espera-mesero { font-size: 12px; font-weight: 700; color: #1e7a45; text-align: center; }
        .pedido-head {
            border-bottom: 1px solid #f0ead9; padding: 12px 18px;
            display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;
        }

        .pedido-num { font-weight: 800; color: var(--marron); font-size: 16px; }
        .pedido-cliente { color: #7a6a52; font-size: 13px; }
        .chip-estado {
            padding: 3px 12px; border-radius: 20px; color: #fff; font-size: 12px; font-weight: 700;
        }
        .chip-pendiente { background: linear-gradient(135deg, #e67e22, #d35400); }
        .chip-prep { background: linear-gradient(135deg, #f39c12, #e67e22); }
        .chip-listp { background: linear-gradient(135deg, #27ae60, #1e8449); }
        .chip-tipo {
            display: inline-block; margin-left: 8px; padding: 2px 10px; border-radius: 20px;
            font-size: 11px; font-weight: 700; vertical-align: middle;
        }
        .pedido-body { padding: 14px 18px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
        .detalle-productos { flex: 1 1 320px; }
        .prod-linea {
            display: flex; justify-content: space-between; padding: 7px 0;
            border-bottom: 1px dashed #eee5d0;
        }
        .prod-linea:last-child { border-bottom: none; }
        .prod-cant { font-weight: 800; color: var(--dorado-oscuro); margin-right: 14px; }
        .prod-nombre { font-weight: 600; color: var(--marron); }
        .prod-meta { font-size: 12px; color: #a89a80; }
        .pedido-acciones { flex: 0 0 auto; display: flex; flex-direction: column; gap: 8px; justify-content: center; }
        .btn-cocina {
            border: none; color: #fff; font-weight: 700; padding: 8px 16px; border-radius: 8px;
            min-width: 170px; transition: all .25s ease;
        }
        .btn-preb { background: linear-gradient(135deg, #f39c12, #e67e22); }
        .btn-listp { background: linear-gradient(135deg, #27ae60, #1e8449); }
        .btn-cocina:hover { transform: translateY(-2px); filter: brightness(1.05); box-shadow: 0 6px 14px rgba(0,0,0,.15); }
        /* Campana: avisa por voz "Pedido número N listo" para que el mesero sepa cuál retirar */
        .btn-campana {
            border: none; color: #fff; font-weight: 800; padding: 10px 16px; border-radius: 10px;
            width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;
            font-size: 15px; background: linear-gradient(135deg, #2ecc71, #1e8449);
            box-shadow: 0 4px 12px rgba(39,174,96,.35); transition: all .25s ease;
        }
        .btn-campana:hover { transform: translateY(-2px); filter: brightness(1.08); }
        .btn-campana .campana-ico { font-size: 20px; }
        .btn-campana.hablando { background: linear-gradient(135deg, #95a5a6, #7f8c8d); box-shadow: none; }
        .btn-campana.avisado { background: linear-gradient(135deg, #27ae60, #145a32); }
        .sin-voz {
            font-size: 12px; font-weight: 700; color: #b03a2e; text-align: center; line-height: 1.35;
        }
        .estado-anuncio { font-size: 12px; font-weight: 700; color: #1e7a45; text-align: center; }
        .btn-volver {
            border: 1px solid #1e8449; background: #fff; color: #1e7a45; font-weight: 700;
            font-size: 12px; padding: 5px 10px; border-radius: 8px; width: 100%;
            transition: all .2s ease;
        }
        .btn-volver:hover { background: #eafaf0; transform: translateY(-1px); }
        .btn-volver.preguntando { background: #fdf2e9; border-color: #c0392b; color: #922b21; }
        .fila-confirmar {
            background: #fff; border: 1px solid #e0b4b4; border-radius: 8px; padding: 8px;
        }
        .fc-pregunta { font-size: 12px; font-weight: 700; color: #922b21; text-align: center; margin-bottom: 7px; }
        .fc-botones { display: flex; gap: 6px; }
        .fc-si, .fc-no {
            flex: 1; border: none; border-radius: 6px; padding: 7px 4px;
            font-size: 12px; font-weight: 800; cursor: pointer; transition: filter .2s ease;
        }
        .fc-si { background: #c0392b; color: #fff; }
        .fc-no { background: #ecf0f1; color: #566573; }
        .fc-si:hover, .fc-no:hover { filter: brightness(1.08); }

        .pie-tiempo { font-size: 13px; color: #9c8b73; padding: 10px 18px; border-top: 1px solid #f0ead9; background: #fdfbf5; }
        /* Pedido PENDIENTE sin atender: parpadea en rojo hasta que lo marcan EN PREPARACION */
        .pedido-card.pedido-blink {
            animation: blinkPendiente 1s steps(2, start) infinite;
        }
        @@keyframes blinkPendiente {
            0%, 49% { background: #fff; border-left-color: #e74c3c; }
            50%, 100% { background: #ffd9d9; border-left-color: #a00; }
        }
    </style>

    <link href="~/css/marca.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Cocina"><img src="~/img/logo-nav.png" alt="" class="marca-logo" /><span class="marca-nombre">El Rincón Dorado</span><span class="marca-modulo">Cocina</span></a>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span class="text-white-50 me-2">👤 @(nombre ?? "Cocinero")</span>
                <form method="post" action="/Auth/Logout">
                    <button type="submit" class="btn btn-logout btn-sm">Cerrar sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container-custom">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <h3 class="titulo-panel mb-0">
                👨‍🍳 Cola de pedidos <small>· POS del cajero</small>
            </h3>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge-lista" id="envoltorioListos" style="display:@(listos > 0 ? "" : "none");">
                    ✅ <span id="contadorListos">@listos</span> listo@(listos == 1 ? "" : "s")
                </span>
                <a href="/Cocina/Index" class="badge-cola text-decoration-none">🔄 <span id="contadorCola">@(hayPedidos ? Model.Count() : 0)</span> en cola</a>
            </div>
        </div>


        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Exito"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!hayPedidos)
        {
            <div class="vacio-cocina" id="colaVacia">
                <div class="emblema">👨‍🍳</div>
                <h4 class="mt-3 mb-1">La cocina está al día</h4>
                <p class="mb-0">No hay pedidos pendientes ni listos. Cuando el cajero factura un pedido aparece aquí en la cola, y se queda en verde hasta que el mesero lo retire.</p>

            </div>
        }
        else
        {
            <div class="row" id="colaPedidos">
                @foreach (var pedido in Model)
                {
                    var clase = pedido.Estado == "LISTO" ? "listo"
                        : pedido.Estado == "EN PREPARACION" ? "prep"
                        : pedido.Estado == "PENDIENTE" ? "urgente pedido-blink"
                        : "urgente";
                    var detalle = pedido.DetallesPedidos ?? Enumerable.Empty<DetallePedido>();
                    var total = pedido.Total > 0 ? pedido.Total : (pedido.Subtotal - pedido.Descuento);

                    <div class="col-12 col-lg-6">
                        <div class="pedido-card @clase">
                            <div class="pedido-head">
                                <div>
                                    <div class="pedido-num">🍽️ Pedido #@pedido.IdPedido
                                        @if (pedido.TipoPedido == "MESA")
                                        {
                                            <span class="chip-tipo" style="@(pedido.Mesa != null ? "background:#e8f0e8;color:#2e6b1e;" : "background:#eef0f5;color:#3d5a80;")">🍽️ Mesa @(pedido.Mesa?.Numero ?? 0)</span>
                                        }
                                        else
                                        {
                                            <span class="chip-tipo" style="background:#f5ecd3;color:#8a6d1a;">🥡 Para llevar</span>
                                        }
                                    </div>
                                    <div class="pedido-cliente">
                                        👤 @(string.IsNullOrWhiteSpace(pedido.NombrePedido) ? "Cliente" : pedido.NombrePedido)
                                        @if (!string.IsNullOrWhiteSpace(pedido.Empleado?.Nombre))
                                        {
                                            <span> · Cajero: @pedido.Empleado.Nombre @pedido.Empleado.Apellido</span>
                                        }
                                    </div>
                                </div>
                                <span class="chip-estado
                                      @(pedido.Estado == "LISTO" ? "chip-listp" : pedido.Estado == "EN PREPARACION" ? "chip-prep" : "chip-pendiente")">
                                    @pedido.Estado
                                </span>
                            </div>
                            <div class="pedido-body">
                                <div class="detalle-productos">
                                    @foreach (var d in detalle)
                                    {
                                        <div class="prod-linea">
                                            <div>
                                                <span class="prod-cant">@d.Cantidad ×</span>
                                                <span class="prod-nombre">@(d.Producto?.Nombre ?? "Producto")</span>
                                                @if (!string.IsNullOrWhiteSpace(d.Observacion))
                                                {
                                                    <div class="prod-meta">📝 @d.Observacion</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="pedido-acciones">
                                    @if (pedido.Estado == "PENDIENTE")
                                    {
                                        <form method="post" action="/Cocina/CambiarEstado">
                                            <input type="hidden" name="id" value="@pedido.IdPedido" />
                                            <input type="hidden" name="estado" value="EN PREPARACION" />
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-cocina btn-preb w-100">👨‍🍳 Empezar</button>
                                        </form>
                                    }
                                    @if (pedido.Estado == "EN PREPARACION")
                                    {
                                        <form method="post" action="/Cocina/CambiarEstado">
                                            <input type="hidden" name="id" value="@pedido.IdPedido" />
                                            <input type="hidden" name="estado" value="LISTO" />
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-cocina btn-listp w-100">✅ Marcarlo listo</button>
                                        </form>
                                    }
                                    @if (pedido.Estado == "LISTO")
                                    {
                                        <button type="button" class="btn-campana" data-anunciar="@pedido.IdPedido"
                                                title="Avisar por voz que el pedido @pedido.IdPedido está listo">
                                            <span class="campana-ico">🔔</span> Pedido @pedido.IdPedido listo
                                        </button>
                                        <div class="espera-mesero">Queda aquí hasta que el mesero lo retire 🍽️</div>
                                        <button type="button" class="btn-volver" data-volver="@pedido.IdPedido"
                                                title="Devolver el pedido @pedido.IdPedido a preparación por si se marcó listo antes de tiempo">
                                            ↩ Volver a preparación
                                        </button>
                                    }
                                </div>

                            </div>
                            <div class="pie-tiempo">
                                ⏱️ Creado: @pedido.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                @if (pedido.EstadoPago == "EFECTIVO")
                                {
                                    <span class="ms-2">· 💵 Pago en efectivo</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div id="fToken" style="display:none;">@Html.AntiForgeryToken()</div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        // ================= Avisos =================
        // El aviso de "pedido nuevo pendiente" lo reproduce la APLICACIÓN
        // (Services/AvisoPedidosCocinaService) por las bocinas de Windows: Chrome bloquea el audio
        // automático si la pestaña no tuvo un clic previo y ese aviso no puede perderse en silencio,
        // porque la cocina no está mirando la pantalla.
        //
        // La campana del pedido listo es otra cosa: se pulsa a mano y habla el equipo con su propia
        // voz. No lleva ningún sonido de fondo, para que no se mezcle con el aviso de pedido
        // pendiente ni con otro pedido ya anunciado.
        // La campana solo habla; el resto de esta pantalla no reproduce audio desde el navegador.
        // ================= Tablero en vivo + anuncios =================
        var contenedor = document.getElementById('colaPedidos');
        var vacio = document.getElementById('colaVacia');
        var contador = document.getElementById('contadorCola');
        var contadorListos = document.getElementById('contadorListos');
        var envoltorioListos = document.getElementById('envoltorioListos');

        var token = (function () {
            var el = document.querySelector('#fToken input');
            return el ? el.value : '';
        })();

        // ids pendientes actuales (se refresca en cada poll; el ciclo de voz lo anuncia cada 10 s)
        function esc(s) {
            return (s == null ? '' : String(s)).replace(/[&<>"']/g,
                function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; });
        }
        function hiddenToken() {
            return '<input type="hidden" name="__RequestVerificationToken" value="' + esc(token) + '" />';
        }

        // ================= Campana: "Pedido número N listo" =================
        // La campana se pulsa a mano, así que el aviso por voz sale con el clic (Chrome no lo
        // bloquea). La voz se lee del propio equipo con la voz de Windows, sin archivos ni red.
        var vozEspanola = null;
        function obtenerVozEspanola() {
            if (!('speechSynthesis' in window)) return null;
            var voces = window.speechSynthesis.getVoices() || [];
            for (var i = 0; i < voces.length; i++) {
                if (voces[i].lang && voces[i].lang.toLowerCase().indexOf('es') === 0) {
                    vozEspanola = voces[i];
                    break;
                }
            }
            return vozEspanola;
        }
        if ('speechSynthesis' in window) {
            window.speechSynthesis.onvoiceschanged = function () { vozEspanola = null; obtenerVozEspanola(); };
            obtenerVozEspanola();
        }
        function hayVoz() { return 'speechSynthesis' in window && window.SpeechSynthesisUtterance != null; }

        // Los pedidos ya anunciados quedan marcados en la tarjeta (se borra solo al desaparecer).
        var pedidosAvisados = {};
        function marcarAvisado(btn, avisado) {
            if (!btn) return;
            btn.classList.toggle('avisado', !!avisado);
            var pie = btn.parentNode ? btn.parentNode.querySelector('.estado-anuncio') : null;
            if (!pie) {
                pie = document.createElement('div');
                pie.className = 'estado-anuncio';
                btn.parentNode.appendChild(pie);
            }
            pie.className = avisado ? 'estado-anuncio' : 'estado-anuncio sin-voz';
            pie.textContent = avisado
                ? '✅ Avisado al mesero'
                : '⚠ Este equipo no tiene voz en español para hablar';
        }
        function anunciarListo(idPedido) {
            var btn = document.querySelector('#colaPedidos [data-anunciar="' + idPedido + '"]');
            if (btn) btn.classList.add('hablando');

            // Solo habla la voz: aquí no se reproduce ningún archivo de audio, porque se mezclaría
            // con el aviso de pedido pendiente que suena en el equipo cada 10 s.
            if (hayVoz()) {
                try {
                    window.speechSynthesis.cancel();
                    var u = new SpeechSynthesisUtterance('Pedido número ' + idPedido + ' listo');
                    var v = obtenerVozEspanola();
                    if (v) { u.voice = v; u.lang = v.lang; } else { u.lang = 'es-ES'; }
                    u.rate = 1; u.pitch = 1; u.volume = 1;
                    u.onend = function () { if (btn) btn.classList.remove('hablando'); };
                    u.onerror = function () { if (btn) btn.classList.remove('hablando'); };
                    window.speechSynthesis.speak(u);
                    pedidosAvisados[idPedido] = true;
                    marcarAvisado(btn, true);
                } catch (e) {
                    if (btn) btn.classList.remove('hablando');
                }
            } else {
                if (btn) btn.classList.remove('hablando');
                marcarAvisado(btn, false);
            }
        }
        if (contenedor) {
            contenedor.addEventListener('click', function (ev) {
                if (!ev.target.closest) return;
                var si = ev.target.closest('[data-confirmar-si]');
                if (si) { confirmarVolver(si.getAttribute('data-confirmar-si')); return; }
                var no = ev.target.closest('[data-confirmar-no]');
                if (no) { cerrarPregunta(); return; }
                var volver = ev.target.closest('[data-volver]');
                if (volver) { preguntarVolver(volver.getAttribute('data-volver')); return; }
                var campana = ev.target.closest('[data-anunciar]');
                if (campana) anunciarListo(campana.getAttribute('data-anunciar'));
            });
        }

        // Volver a preparación deshace lo que hizo la cocina, así que no se manda en el primer clic:
        // el botón abre la pregunta en la misma tarjeta y solo sale si se pulsa "Sí, volver".
        // (Nada de window.confirm: el aviso del navegador tapa la tarjeta y en una pantalla de
        // cocina molesta más de lo que ayuda.)
        var pedidoConfirmando = null;
        function filaPregunta(id) {
            return '<div class="fila-confirmar" data-pregunta="' + id + '">'
                + '<div class="fc-pregunta">¿Seguro que quieres devolver el pedido ' + id + ' a preparación?</div>'
                + '<div class="fc-botones">'
                + '<button type="button" class="fc-si" data-confirmar-si="' + id + '">Sí, volver</button>'
                + '<button type="button" class="fc-no" data-confirmar-no="' + id + '">Cancelar</button>'
                + '</div></div>';
        }
        function preguntarVolver(idPedido) {
            if (pedidoConfirmando != null) cerrarPregunta();
            var btn = document.querySelector('#colaPedidos [data-volver="' + idPedido + '"]');
            if (!btn) return;
            pedidoConfirmando = idPedido;
            btn.classList.add('preguntando');
            var div = document.createElement('div');
            div.innerHTML = filaPregunta(idPedido);
            btn.parentNode.appendChild(div.firstChild);
        }
        function cerrarPregunta() {
            if (pedidoConfirmando != null) {
                var btn = document.querySelector('#colaPedidos [data-volver="' + pedidoConfirmando + '"]');
                if (btn) btn.classList.remove('preguntando');
            }
            pedidoConfirmando = null;
            Array.prototype.forEach.call(
                document.querySelectorAll('#colaPedidos .fila-confirmar'),
                function (f) { f.parentNode.removeChild(f); });
        }
        function confirmarVolver(idPedido) {
            cerrarPregunta();
            delete pedidosAvisados[idPedido];
            var f = document.createElement('form');
            f.method = 'post';
            f.action = '/Cocina/CambiarEstado';
            f.innerHTML = '<input type="hidden" name="id" value="' + esc(idPedido) + '" />'
                + '<input type="hidden" name="estado" value="EN PREPARACION" />'
                + hiddenToken();
            document.body.appendChild(f);
            f.submit();
        }


        function renderCola(datos) {
            var hay = datos && datos.length > 0;
            var cuantosListos = hay ? datos.filter(function (p) { return p.estado === 'LISTO'; }).length : 0;
            contador.textContent = hay ? datos.length : 0;
            if (contadorListos) {
                contadorListos.textContent = cuantosListos;
                if (envoltorioListos) envoltorioListos.style.display = cuantosListos ? '' : 'none';
            }
            if (!hay) {
                vacio.style.display = '';
                contenedor.innerHTML = '';
                return;
            }
            vacio.style.display = 'none';
            var html = '<div class="row">';
            datos.forEach(function (p) {
                var esPreparacion = p.estado === 'EN PREPARACION';
                var esPendiente = p.estado === 'PENDIENTE';
                var esListo = p.estado === 'LISTO';
                var claseCard = esListo ? 'pedido-card listo'
                    : esPreparacion ? 'pedido-card prep'
                    : esPendiente ? 'pedido-card urgente pedido-blink'
                    : 'pedido-card urgente';
                var claseChip = esListo ? 'chip-listp' : esPreparacion ? 'chip-prep' : 'chip-pendiente';

                var chipTipo = p.tipoPedido === 'MESA'
                    ? '<span class="chip-tipo" style="background:#e8f0e8;color:#2e6b1e;">🍽️ Mesa ' + (p.mesaNumero || 0) + '</span>'
                    : '<span class="chip-tipo" style="background:#f5ecd3;color:#8a6d1a;">🥡 Para llevar</span>';
                var pago = p.estadoPago === 'EFECTIVO' ? '<span class="ms-2">· 💵 Pago en efectivo</span>' : '';
                var fecha = p.fechaCreacion ? new Date(p.fechaCreacion).toLocaleString('es-BO') : '';
                var detalle = '';
                (p.detalle || []).forEach(function (d) {
                    detalle += '<div class="prod-linea"><div><span class="prod-cant">' + d.cantidad + ' ×</span>'
                        + '<span class="prod-nombre">' + esc(d.nombre) + '</span>'
                        + (d.observacion ? '<div class="prod-meta">📝 ' + esc(d.observacion) + '</div>' : '')
                        + '</div></div>';
                });
                var acciones = '';
                if (p.estado === 'PENDIENTE') {
                    acciones = '<form method="post" action="/Cocina/CambiarEstado">'
                        + '<input type="hidden" name="id" value="' + p.idPedido + '" />'
                        + '<input type="hidden" name="estado" value="EN PREPARACION" />'
                        + hiddenToken()
                        + '<button type="submit" class="btn-cocina btn-preb w-100">👨‍🍳 Empezar</button></form>';
                } else if (esPreparacion) {
                    acciones = '<form method="post" action="/Cocina/CambiarEstado">'
                        + '<input type="hidden" name="id" value="' + p.idPedido + '" />'
                        + '<input type="hidden" name="estado" value="LISTO" />'
                        + hiddenToken()
                        + '<button type="submit" class="btn-cocina btn-listp w-100">✅ Marcarlo listo</button></form>';
                } else if (esListo) {
                    var avisado = !!pedidosAvisados[p.idPedido];
                    var preguntando = pedidoConfirmando == p.idPedido;
                    acciones = '<button type="button" class="btn-campana' + (avisado ? ' avisado' : '') + '"'
                        + ' data-anunciar="' + p.idPedido + '"'
                        + ' title="Avisar por voz que el pedido ' + p.idPedido + ' está listo">'
                        + '<span class="campana-ico">🔔</span> Pedido ' + p.idPedido + ' listo</button>'
                        + '<div class="espera-mesero">Queda aquí hasta que el mesero lo retire 🍽️</div>'
                        + (avisado ? '<div class="estado-anuncio">✅ Avisado al mesero</div>' : '')
                        + '<button type="button" class="btn-volver' + (preguntando ? ' preguntando' : '') + '"'
                        + ' data-volver="' + p.idPedido + '"'
                        + ' title="Devolver el pedido ' + p.idPedido + ' a preparación por si se marcó listo antes de tiempo">'
                        + '↩ Volver a preparación</button>'
                        // El tablero se repinta cada 2 s, así que la pregunta abierta se vuelve a
                        // dibujar: si no, el cocinero nunca alcanzaría a contestarla.
                        + (preguntando ? filaPregunta(p.idPedido) : '');
                }
                if (!esListo) {
                    delete pedidosAvisados[p.idPedido];
                    if (pedidoConfirmando == p.idPedido) pedidoConfirmando = null;
                }

                html += '<div class="col-12 col-lg-6"><div class="' + claseCard + '">'
                    + '<div class="pedido-head"><div><div class="pedido-num">🍽️ Pedido #' + p.idPedido + chipTipo + '</div>'
                    + '<div class="pedido-cliente">👤 ' + esc(p.nombrePedido || 'Cliente')
                    + (p.nombreCajero ? '<span> · Cajero: ' + esc(p.nombreCajero) + '</span>' : '')
                    + '</div></div><span class="chip-estado ' + claseChip + '">' + esc(p.estado) + '</span></div>'
                    + '<div class="pedido-body"><div class="detalle-productos">' + detalle + '</div>'
                    + '<div class="pedido-acciones">' + acciones + '</div></div>'
                    + '<div class="pie-tiempo">⏱️ Creado: ' + fecha + pago + '</div></div></div>';
            });
            html += '</div>';
            contenedor.innerHTML = html;
        }

        var recargaHecha = false;
        function recargarPorSesion() {
            if (recargaHecha) return;
            recargaHecha = true;
            var ultima = 0;
            try { ultima = parseInt(sessionStorage.getItem('cocinaRecarga') || '0', 10) || 0; } catch (e) { }
            if (Date.now() - ultima < 60000) return;   // ya se intentó hace menos de 1 min
            try { sessionStorage.setItem('cocinaRecarga', String(Date.now())); } catch (e) { }
            setTimeout(function () { location.reload(); }, 1200);
        }
        async function actualizarCola() {
            try {
                var res = await fetch('/Cocina/ActualizarCola', { cache: 'no-store' });
                var texto = await res.text();
                var datos = null;
                try { datos = JSON.parse(texto); } catch (e) { datos = null; }
                if (datos === null) {
                    // Lo habitual es que la sesión haya vencido (el fetch devuelve el HTML del
                    // login): en ese caso una recarga deja la pantalla funcionando sola.
                    if (res.redirected) recargarPorSesion();
                    return;
                }
                renderCola(datos);
            } catch (e) {
                // Sin banner: la cola se reintenta en el siguiente poll.
            }
        }

        // Latido: mientras esta pantalla esté abierta, la app puede emitir el aviso sonoro.
        // Si se cierra la pestaña o se navega a otra pantalla, deja de llegar y el aviso se detiene.
        function latidoCocina() {
            try {
                fetch('/Cocina/Ping', { cache: 'no-store' }).catch(function () { });
            } catch (e) { }
        }

        // ================= SignalR: Conexión en tiempo real =================
        var connection = null;
        async function iniciarSignalR() {
            try {
                connection = new signalR.HubConnectionBuilder()
                    .withUrl('/pedidosHub')
                    .withAutomaticReconnect()
                    .build();

                connection.on('RecibirNuevoPedido', function (idPedido) {
                    console.log('Nuevo pedido recibido:', idPedido);
                    actualizarCola();
                });

                connection.on('RecibirCambioEstado', function (idPedido, estado) {
                    console.log('Cambio de estado:', idPedido, estado);
                    actualizarCola();
                });

                connection.onreconnected(function () {
                    console.log('SignalR reconectado');
                    connection.invoke('UnirseACocina');
                });

                await connection.start();
                console.log('SignalR conectado');
                await connection.invoke('UnirseACocina');
            } catch (err) {
                console.error('Error al conectar SignalR:', err);
                setTimeout(iniciarSignalR, 5000);
            }
        }

        // Iniciar SignalR
        iniciarSignalR();

        // Tablero: poll cada 2 s como respaldo. SignalR maneja las actualizaciones en tiempo real.
        actualizarCola();
        latidoCocina();
        setInterval(actualizarCola, 2000);
        setInterval(latidoCocina, 10000);
    </script>

</body>
</html>
