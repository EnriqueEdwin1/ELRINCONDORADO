@model ELRINCONDORADO.Models.DestinoInsumo
@{
    ViewData["Title"] = "Eliminar Destino";
    Layout = null;
    var nombre = Context.Session.GetString("Nombre");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/administrador.css" rel="stylesheet" />
    <link href="~/css/crud.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Administrador">🏪 El Rincón Dorado</a>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span class="text-white">@nombre</span>
                <form method="post" action="/Auth/Logout" style="display: inline;">
                    <button type="submit" class="btn btn-logout btn-sm">Cerrar sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container-custom">
        <div class="form-card">
            <h2>Eliminar Destino</h2>
            <p class="mb-3">¿Estás seguro de que deseas eliminar el destino <strong>@Model.Nombre</strong>?</p>
            <p class="text-muted">No podrá eliminarse si hay insumos asignados a este destino.</p>
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdDestino" />
                <button type="submit" class="btn btn-eliminar">Eliminar</button>
                <a asp-action="Index" class="btn btn-cancelar mt-2 text-center">Cancelar</a>
            </form>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>