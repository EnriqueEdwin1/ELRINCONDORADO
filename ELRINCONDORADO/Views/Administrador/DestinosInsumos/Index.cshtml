@model IEnumerable<ELRINCONDORADO.Models.DestinoInsumo>
@{
    ViewData["Title"] = "Destinos de Insumos";
    Layout = null;
    var nombre = Context.Session.GetString("Nombre");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/administrador.css" rel="stylesheet" />
    <link href="~/css/crud.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Administrador">🏪 El Rincón Dorado</a>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span class="text-white">@nombre</span>
                <form method="post" action="/Auth/Logout" style="display: inline;">
                    <button type="submit" class="btn btn-logout btn-sm">Cerrar sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container-custom">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-0">
                <a href="/Administrador" class="btn btn-sm btn-outline-secondary me-2">← Volver a administración</a>
                Destinos de Insumos
            </h2>
            <a href="/DestinosInsumos/Create" class="btn btn-modulo">Agregar destino</a>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <input type="text" id="buscarDestino" class="form-control mb-3"
               placeholder="Buscar destino por nombre..." />

        <table class="table table-crud" id="tablaDestinos">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Insumos Asignados</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="fila-clic" data-nombre="@item.Nombre"
                        onclick="window.location.href='@Url.Action("Details", new { id = item.IdDestino })';">
                        <td>@item.IdDestino</td>
                        <td>@item.Nombre</td>
                        <td>@(item.Insumos?.Count ?? 0)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var buscar = document.getElementById('buscarDestino');
            if (!buscar) return;
            buscar.addEventListener('input', function () {
                var filtro = buscar.value.toLowerCase();
                document.querySelectorAll('#tablaDestinos tbody tr').forEach(function (tr) {
                    var dest = tr.getAttribute('data-nombre') || '';
                    tr.style.display = (dest.toLowerCase().indexOf(filtro) !== -1) ? '' : 'none';
                });
            });
        });
    </script>
</body>
</html>