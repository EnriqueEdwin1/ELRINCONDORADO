@model IEnumerable<ELRINCONDORADO.Models.MovimientoInventario>
@using ELRINCONDORADO.Helpers
@{
    ViewData["Title"] = "Movimientos";
    Layout = null;
    var nombre = Context.Session.GetString("Nombre");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/administrador.css" rel="stylesheet" />
    <link href="~/css/crud.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Administrador">🏪 El Rincón Dorado</a>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span class="text-white">@nombre</span>
                <form method="post" action="/Auth/Logout" style="display: inline;">
                    <button type="submit" class="btn btn-logout btn-sm">Cerrar sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container-custom">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-0">
                <a href="/Administrador" class="btn btn-sm btn-outline-secondary me-2">← Volver a administración</a>
                Movimientos
            </h2>
            <a href="/MovimientosInventario/Create" class="btn btn-modulo">Registrar salida</a>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <input type="text" id="buscarMovimiento" class="form-control mb-3"
               placeholder="Buscar por insumo, empleado o motivo..." />

        <table class="table table-crud" id="tablaMovimientos">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Fecha</th>
                    <th>Insumo</th>
                    <th>Tipo</th>
                    <th>Cantidad</th>
                    <th>Empleado</th>
                    <th>Motivo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="fila-clic" data-nombre="@(item.Insumo?.Nombre ?? "") @(item.Empleado?.Usuario ?? "") @(item.Motivo ?? "")"
                        onclick="window.location.href='@Url.Action("Details", new { id = item.IdMovimiento })';">
                        <td>@item.IdMovimiento</td>
                        <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(item.Insumo?.Nombre ?? "—")</td>
                        <td>
                            @if (item.TipoMovimiento == "SALIDA")
                            {
                                <span class="badge-estado inactivo">Salida</span>
                            }
                            else
                            {
                                <span class="badge-estado activo">Entrada</span>
                            }
                        </td>
                        <td>@MonedaHelper.FormatearNumero(item.Cantidad)</td>
                        <td>@(item.Empleado?.Usuario ?? "—")</td>
                        <td>@(item.Motivo ?? "—")</td>
                        <td>
                            <div class="d-flex gap-1 justify-content-end">
                                <a asp-action="Details" asp-route-id="@item.IdMovimiento" class="btn btn-sm btn-detalle">Ver</a>
                                <a asp-action="Edit" asp-route-id="@item.IdMovimiento" class="btn btn-sm btn-editar">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.IdMovimiento" class="btn btn-sm btn-eliminar">Eliminar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var buscar = document.getElementById('buscarMovimiento');
            if (!buscar) return;
            buscar.addEventListener('input', function () {
                var filtro = buscar.value.toLowerCase();
                document.querySelectorAll('#tablaMovimientos tbody tr').forEach(function (tr) {
                    var texto = tr.getAttribute('data-nombre') || '';
                    tr.style.display = (texto.toLowerCase().indexOf(filtro) !== -1) ? '' : 'none';
                });
            });
        });
    </script>
</body>
</html>
