@model ELRINCONDORADO.Models.MovimientoInventario
@{
    ViewData["Title"] = "Editar Movimiento";
    Layout = null;
    var nombre = Context.Session.GetString("Nombre");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/administrador.css" rel="stylesheet" />
    <link href="~/css/crud.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Administrador">🏪 El Rincón Dorado</a>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span class="text-white">@nombre</span>
                <form method="post" action="/Auth/Logout" style="display: inline;">
                    <button type="submit" class="btn btn-logout btn-sm">Cerrar sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container-custom">
        <div class="form-card">
            <h2>Editar Movimiento</h2>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="IdMovimiento" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="IdInsumo" class="form-label">Insumo</label>
                        <select asp-for="IdInsumo" class="form-control" asp-items="ViewBag.IdInsumo" required></select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="IdEmpleado" class="form-label">Empleado</label>
                        <select asp-for="IdEmpleado" class="form-control" asp-items="ViewBag.IdEmpleado" required></select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="TipoMovimiento" class="form-label">Tipo</label>
                        <select asp-for="TipoMovimiento" class="form-control" required>
                            <option value="SALIDA">Salida (salida de insumo)</option>
                            <option value="ENTRADA">Entrada</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Cantidad" class="form-label">Cantidad</label>
                        <input asp-for="Cantidad" class="form-control" type="number" step="0.01" min="0" required />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Fecha" class="form-label">Fecha</label>
                        <input asp-for="Fecha" class="form-control" type="datetime-local"
                               value="@Model.Fecha.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Motivo" class="form-label">Motivo</label>
                    <input asp-for="Motivo" class="form-control" type="text" maxlength="100"
                           placeholder="Ej: Preparación de receta, merma..." />
                </div>

                <button type="submit" class="btn btn-guardar">Guardar cambios</button>
                <a asp-action="Index" class="btn btn-cancelar mt-2 text-center">Cancelar</a>
            </form>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
