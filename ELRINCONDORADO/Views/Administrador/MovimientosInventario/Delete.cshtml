@model ELRINCONDORADO.Models.MovimientoInventario
@using ELRINCONDORADO.Helpers
@{
    ViewData["Title"] = "Eliminar Movimiento";
    Layout = null;
    var nombre = Context.Session.GetString("Nombre");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/administrador.css" rel="stylesheet" />
    <link href="~/css/crud.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Administrador">🏪 El Rincón Dorado</a>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span class="text-white">@nombre</span>
                <form method="post" action="/Auth/Logout" style="display: inline;">
                    <button type="submit" class="btn btn-logout btn-sm">Cerrar sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container-custom">
        <div class="form-card text-center">
            <h2>Eliminar Movimiento</h2>
            <p class="mb-4">
                ¿Estás seguro de que deseas eliminar la salida de
                <strong>@(Model.Insumo?.Nombre ?? "insumo")</strong>
                (cantidad @MonedaHelper.FormatearNumero(Model.Cantidad))?
            </p>
            <p class="text-muted mb-4">Esta acción no se puede deshacer.</p>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdMovimiento" />
                <button type="submit" class="btn btn-eliminar w-100 mb-2">Sí, eliminar</button>
                <a asp-action="Index" class="btn btn-link w-100">Cancelar</a>
            </form>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
