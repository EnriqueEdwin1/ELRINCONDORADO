@model ELRINCONDORADO.Models.Insumo
@using ELRINCONDORADO.Helpers
@{
    ViewData["Title"] = "Detalle Insumo";
    Layout = null;
    var nombre = Context.Session.GetString("Nombre");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/administrador.css" rel="stylesheet" />
    <link href="~/css/crud.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Administrador">🏪 El Rincón Dorado</a>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span class="text-white">@nombre</span>
                <form method="post" action="/Auth/Logout" style="display: inline;">
                    <button type="submit" class="btn btn-logout btn-sm">Cerrar sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container-custom">
        <div class="form-card">
            <h2>Detalle del Insumo</h2>
            <dl class="row">
                <dt class="col-sm-4">ID</dt>
                <dd class="col-sm-8">@Model.IdInsumo</dd>

                <dt class="col-sm-4">Nombre</dt>
                <dd class="col-sm-8">@Model.Nombre</dd>

                <dt class="col-sm-4">Descripción</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Descripcion) ? "—" : Model.Descripcion)</dd>

                <dt class="col-sm-4">Destino</dt>
                <dd class="col-sm-8">@(Model.Destino?.Nombre ?? "—")</dd>

                <dt class="col-sm-4">Unidad de Medida</dt>
                <dd class="col-sm-8">@Model.UnidadMedida</dd>

                <dt class="col-sm-4">Stock Actual</dt>
                <dd class="col-sm-8">@MonedaHelper.FormatearNumero(Model.StockActual) @Model.UnidadMedida</dd>

                <dt class="col-sm-4">Stock Mínimo</dt>
                <dd class="col-sm-8">@MonedaHelper.FormatearNumero(Model.StockMinimo) @Model.UnidadMedida</dd>

                <dt class="col-sm-4">Costo Unitario</dt>
                <dd class="col-sm-8">@MonedaHelper.FormatearBs(Model.CostoUnitario)</dd>

                <dt class="col-sm-4">Estado</dt>
                <dd class="col-sm-8">
                    @if (Model.Activo)
                    {
                        <span class="badge-estado activo">Activo</span>
                    }
                    else
                    {
                        <span class="badge-estado inactivo">Inactivo</span>
                    }
                </dd>
            </dl>
            <a href="/Administrador" class="btn btn-sm btn-outline-secondary">← Volver a administración</a>
            <a href="/Insumos" class="btn btn-modulo">Volver a Insumos</a>
            <a asp-action="Edit" asp-route-id="@Model.IdInsumo" class="btn btn-editar">Editar</a>
            <a asp-action="Delete" asp-route-id="@Model.IdInsumo" class="btn btn-eliminar">Eliminar</a>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
