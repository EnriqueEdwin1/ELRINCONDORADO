@model ELRINCONDORADO.Models.Insumo
@using ELRINCONDORADO.Helpers
@{
    ViewData["Title"] = "Editar Insumo";
    Layout = null;
    var nombre = Context.Session.GetString("Nombre");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/administrador.css" rel="stylesheet" />
    <link href="~/css/crud.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Administrador">🏪 El Rincón Dorado</a>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span class="text-white">@nombre</span>
                <form method="post" action="/Auth/Logout" style="display: inline;">
                    <button type="submit" class="btn btn-logout btn-sm">Cerrar sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container-custom">
        <div class="form-card">
            <h2>Editar Insumo</h2>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdInsumo" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="Nombre" class="form-label">Nombre</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Aceite 3L" required
                           pattern="[A-Za-z0-9 ÁÉÍÓÚÜÑáéíóúüñ-]+"
                           title="El nombre no puede contener símbolos." />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Descripcion" class="form-label">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="2" placeholder="Ej: Harina de trigo para la masa"></textarea>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="IdDestino" class="form-label">Destino</label>
                    <select asp-for="IdDestino" class="form-control" asp-items="ViewBag.Destinos"></select>
                    <small class="text-muted">Indica a qué área del restaurante está destinado este insumo (cocina, mesas o bebidas).</small>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="UnidadMedida" class="form-label">Unidad de Medida</label>
                        <select asp-for="UnidadMedida" class="form-control" required>
                            <option value="">Seleccionar...</option>
                            <option value="Unidad">Unidad</option>
                            <option value="Kilogramo">Kilogramo</option>
                            <option value="Litros">Litros</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CostoUnitario" class="form-label">Costo Unitario</label>
                        <input asp-for="CostoUnitario" class="form-control" type="number" step="0.01" min="0" placeholder="Ej: 12.50" required />
                        <small class="text-muted">Costo del insumo por cada unidad de medida (peso, kg o litro).</small>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StockActual" class="form-label">Stock Actual</label>
                        <input name="StockActual" class="form-control" type="number" step="any" min="0" placeholder="Ej: 20" value="@MonedaHelper.FormatearNumero(Model.StockActual)" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="StockMinimo" class="form-label">Stock Mínimo</label>
                        <input name="StockMinimo" class="form-control" type="number" step="any" min="0" placeholder="Ej: 5" value="@MonedaHelper.FormatearNumero(Model.StockMinimo)" />
                        <small class="text-muted">Cantidad mínima antes de tener que reabastecer (0 para no vigilar).</small>
                    </div>
                </div>

                <div class="form-check form-switch mb-4">
                    <input asp-for="Activo" class="form-check-input" type="checkbox" />
                    <label asp-for="Activo" class="form-check-label">Insumo activo</label>
                </div>

                <button type="submit" class="btn btn-guardar">Guardar cambios</button>
                <a asp-action="Index" class="btn btn-cancelar mt-2 text-center">Cancelar</a>
            </form>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
