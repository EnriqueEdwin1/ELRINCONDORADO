@model ELRINCONDORADO.Models.AdminResumenViewModel
@using ELRINCONDORADO.Helpers
@{
    ViewData["Title"] = "Panel de Administración";
    Layout = null;
    var nombre = Context.Session.GetString("Nombre");
    var rol = Context.Session.GetString("Rol");
    var maximo = 8;
    var mostrados = Model.InsumosBajoMinimo.Take(maximo).ToList();
    var restantes = Model.InsumosBajoMinimo.Count - mostrados.Count;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/administrador.css" rel="stylesheet" />
    <link href="~/css/marca.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="#"><img src="~/img/logo-nav.png" alt="" class="marca-logo" /><span class="marca-nombre">El Rincón Dorado</span></a>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span class="text-white">@nombre</span>
                <form method="post" action="/Auth/Logout" style="display: inline;">
                    <button type="submit" class="btn btn-logout btn-sm">Cerrar sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container-custom">
        <div class="welcome-card">
            <h2>¡Bienvenido, @nombre!</h2>
            <p>Rol: <strong>@rol</strong></p>
            <p>Hora de acceso: <strong>@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</strong></p>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-lg-5 mb-3">
                <div class="resumen-card">
                    <div class="resumen-cabecera">
                        <span class="resumen-icono">💰</span>
                        <div>
                            <h5>Vendido en el turno</h5>
                            <small>Lo que va facturando el cajero. Se reinicia al cerrar caja.</small>
                        </div>
                    </div>
                    <div class="resumen-monto">@MonedaHelper.FormatearBs(Model.VendidoTurno)</div>
                    <div class="resumen-pie">
                        <div>
                            @Model.VentasTurno venta@(Model.VentasTurno == 1 ? "" : "s")
                            @if (Model.UltimoCierreLocal.HasValue)
                            {
                                <span>facturadas desde el cierre del @Model.UltimoCierreLocal.Value.ToString("dd/MM/yyyy HH:mm")</span>
                            }
                            else
                            {
                                <span>facturadas (todavía no hay cierres de caja)</span>
                            }
                        </div>
                        <div class="mt-1">
                            Hoy: <strong>@MonedaHelper.FormatearBs(Model.VendidoHoy)</strong>
                            <span class="text-muted">(@Model.VentasHoy venta@(Model.VentasHoy == 1 ? "" : "s"))</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7 mb-3">
                <div class="resumen-card @(Model.InsumosBajoMinimo.Any() ? "resumen-alerta" : "")">
                    <div class="resumen-cabecera">
                        <span class="resumen-icono">⚠️</span>
                        <div>
                            <h5>Insumos bajo el stock mínimo</h5>
                            <small>Hay que comprarlos antes de que falten.</small>
                        </div>
                        <a href="/Insumos" class="btn btn-sm btn-outline-secondary ms-auto">Ver inventario</a>
                    </div>

                    @if (Model.InsumosBajoMinimo.Any())
                    {
                        <ul class="resumen-lista">
                            @foreach (var insumo in mostrados)
                            {
                                <li>
                                    <span>
                                        <strong>@insumo.Nombre</strong>
                                        <span class="text-muted">
                                            — hay @MonedaHelper.FormatearNumero(insumo.StockActual) @insumo.UnidadMedida.ToLowerInvariant(),
                                            mínimo @MonedaHelper.FormatearNumero(insumo.StockMinimo)
                                        </span>
                                    </span>
                                    <span class="resumen-faltante">faltan @MonedaHelper.FormatearNumero(insumo.Faltante)</span>
                                </li>
                            }
                        </ul>
                        <div class="resumen-pie d-flex justify-content-between align-items-center">
                            <span>
                                @(Model.InsumosBajoMinimo.Count == 1 ? "1 insumo" : Model.InsumosBajoMinimo.Count + " insumos")
                                @(restantes > 0 ? $"(+{restantes} más)" : "")
                            </span>
                            <a href="/Compras" class="btn btn-sm btn-modulo">Registrar compra</a>
                        </div>
                    }
                    else
                    {
                        <div class="resumen-ok">✔ Todos los insumos están sobre su stock mínimo.</div>
                        <div class="resumen-pie">
                            <a href="/Insumos" class="btn btn-sm btn-outline-secondary">Ver inventario</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-3 mb-4">
                <div class="card">
                    <div class="card-header">👥 Empleados</div>
                    <div class="card-body">
                        <p>Gestión de empleados y roles.</p>
                        <a href="/Empleados" class="btn btn-sm btn-modulo">Ver empleados</a>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="card">
                    <div class="card-header">🍔 Productos</div>
                    <div class="card-body">
                        <p>Catálogo, categorías y promociones.</p>
                        <a href="/Productos" class="btn btn-sm btn-modulo">Ver productos</a>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="card">
                    <div class="card-header">🧾 Ventas</div>
                    <div class="card-body">
                        <p>Historial de pedidos, detalle y reimpresión de facturas.</p>
                        <a href="/Ventas" class="btn btn-sm btn-modulo">Ver ventas</a>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="card">
                    <div class="card-header">📦 Inventario</div>
                    <div class="card-body">
                        <p>Insumos, stock y movimientos.</p>
                        <a href="/Insumos" class="btn btn-sm btn-modulo">Ver insumos</a>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="card">
                    <div class="card-header">📖 Recetas</div>
                    <div class="card-body">
                        <p>Recetas por producto.</p>
                        <a href="/Recetas" class="btn btn-sm btn-modulo">Ver recetas</a>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="card">
                    <div class="card-header">🚚 Proveedores</div>
                    <div class="card-body">
                        <p>Proveedores y compras.</p>
                        <a href="/Proveedores" class="btn btn-sm btn-modulo">Ver proveedores</a>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="card">
                    <div class="card-header">🛒 Compras</div>
                    <div class="card-body">
                        <p>Registro de compras a proveedores.</p>
                        <a href="/Compras" class="btn btn-sm btn-modulo">Ver compras</a>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="card">
                    <div class="card-header">🔄 Movimientos</div>
                    <div class="card-body">
                        <p>Salidas de insumos del inventario.</p>
                        <a href="/MovimientosInventario" class="btn btn-sm btn-modulo">Ver movimientos</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>