@model ELRINCONDORADO.Models.PromocionFormViewModel
@using ELRINCONDORADO.Helpers
@{
    ViewData["Title"] = Model.EsEdicion ? "Editar Promoción" : "Nueva Promoción";
    Layout = null;
    var nombre = Context.Session.GetString("Nombre");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/marca.css" />
    <link rel="stylesheet" href="~/css/administrador.css" />
</head>
<body class="bg-admin">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h2 class="mb-0">@(Model.EsEdicion ? "Editar promoción" : "Nueva promoción")</h2>
                <p class="text-muted mb-0">
                    Las promociones no tienen categoría: son un paquete de productos del menú con precio propio.
                </p>
            </div>
            <div class="d-flex gap-2">
                <a href="/Administrador" class="btn btn-sm btn-outline-secondary">⌂ Administración</a>
                <a href="/Productos?pestana=promociones" class="btn btn-outline-secondary">Volver</a>
            </div>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        @if (Model.EsEdicion && !string.IsNullOrEmpty(Model.ImagenActual))
        {
            <form method="post" asp-action="PromocionEliminarImagen" asp-route-id="@Model.IdPromocion"
                  onsubmit="return confirm('¿Eliminar la imagen de esta promoción?');" class="mb-3">
                @Html.AntiForgeryToken()
                <div class="d-flex align-items-center gap-2">
                    <img src="@Model.ImagenActual" class="img-thumbnail" style="max-height: 120px;" alt="Imagen actual" />
                    <div>
                        <span class="text-muted d-block">Imagen actual</span>
                        <button type="submit" class="btn btn-sm btn-eliminar mt-1">Eliminar imagen</button>
                    </div>
                </div>
            </form>
        }

        <form method="post" asp-action="@(Model.EsEdicion ? "PromocionEdit" : "PromocionCreate")"
              asp-route-id="@Model.IdPromocion" enctype="multipart/form-data" id="formPromocion">
            <input type="hidden" name="IdPromocion" value="@Model.IdPromocion" />
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-lg-7">
                    <div class="form-card p-3 mb-3">
                        <h5 class="mb-3">Datos de la promoción</h5>

                        <div class="mb-3">
                            <label class="form-label" for="Nombre">Nombre</label>
                            <input type="text" class="form-control" id="Nombre" name="Nombre" required
                                   value="@Model.Nombre" placeholder="Ej: Combo Personal" />
                            <div class="form-text">Es el nombre que verá el cajero y que saldrá en la factura.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="Descripcion">Descripción</label>
                            <input type="text" class="form-control" id="Descripcion" name="Descripcion"
                                   value="@Model.Descripcion" placeholder="Ej: Hamburguesa, papas y bebida" />
                        </div>

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label" for="Precio">Precio de la promoción (Bs)</label>
                                <input type="number" step="0.01" min="0.01" class="form-control" id="Precio"
                                       name="Precio" required value="@Model.Precio.ToString("0.00")" />
                                <div class="form-text">Es el precio que se cobra en el cajero.</div>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="Estado">Estado</label>
                                <select class="form-select" id="Estado" name="Estado">
                                    <option value="ACTIVA" selected="@(Model.Estado == "ACTIVA")">Activa (aparece en el cajero)</option>
                                    <option value="INACTIVA" selected="@(Model.Estado == "INACTIVA")">Inactiva (oculta en el cajero)</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="imagenPromocion">Imagen de la promoción</label>
                            <input type="file" name="imagenFile" id="imagenPromocion" class="form-control" accept="image/*" />
                            <div id="previewPromocionContainer" class="mt-2" style="display: none;">
                                <img id="previewPromocion" class="img-thumbnail" style="max-height: 150px;" alt="Vista previa" />
                            </div>
                            <div class="form-text">Se sube a ImgBB y sale en la lista, en el detalle y en el cajero (opcional).</div>
                        </div>
                    </div>

                    <div class="form-card p-3">
                        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                            <h5 class="mb-0">Productos incluidos</h5>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnTodos">Marcar todos</button>
                        </div>
                        <p class="text-muted small">
                            Marca los productos que incluye la promoción y la cantidad de cada uno. Esos productos
                            son los que se descuentan del stock y los que salen en el pedido.
                        </p>

                        @if (!Model.Incluidos.Any())
                        {
                            <div class="alert alert-warning mb-0">
                                Todavía no hay productos en el catálogo.
                                <a href="/Productos/Create">Crea un producto</a> primero.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0" id="tablaIncluidos">
                                    <thead>
                                        <tr>
                                            <th style="width: 44px;">Incluye</th>
                                            <th>Producto</th>
                                            <th class="text-end" style="width: 110px;">Precio</th>
                                            <th class="text-center" style="width: 90px;">Cantidad</th>
                                            <th class="text-end" style="width: 120px;">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ var indice = 0; }
                                        @foreach (var item in Model.Incluidos)
                                        {
                                            var marcado = item.Seleccionado;
                                            var i = indice++;
                                            <tr class="fila-incluido @(marcado ? "seleccionada" : "")">
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input chk-incluir"
                                                           name="Incluidos[@i].Seleccionado" value="true"
                                                           id="chk@(item.IdProducto)" @(marcado ? "checked" : "") />
                                                </td>
                                                <td>
                                                    <label for="chk@(item.IdProducto)" class="mb-0">@item.Nombre</label>
                                                    <input type="hidden" name="Incluidos[@i].IdProducto" value="@item.IdProducto" />
                                                    @if (!item.Activo)
                                                    {
                                                        <span class="badge-estado inactivo ms-1">Inactivo</span>
                                                    }
                                                </td>
                                                <td class="text-end">@MonedaHelper.FormatearBs(item.Precio)</td>
                                                <td class="text-center">
                                                    <input type="number" min="1" step="1"
                                                           class="form-control form-control-sm cantidad-incluir"
                                                           name="Incluidos[@i].Cantidad"
                                                           value="@item.Cantidad" />
                                                </td>
                                                <td class="text-end subtotal-incluido">@MonedaHelper.FormatearBs(item.Precio * item.Cantidad)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="form-card p-3 mb-3">
                        <h5 class="mb-3">Resumen</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Valor de los productos por separado</span>
                            <strong id="resSuma">@MonedaHelper.FormatearBs(Model.SumaProductos)</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Precio de la promoción</span>
                            <strong id="resPrecio">@MonedaHelper.FormatearBs(Model.Precio)</strong>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between align-items-center">
                            <span>Ahorro del cliente</span>
                            <strong class="fs-5" id="resAhorro">@MonedaHelper.FormatearBs(Model.Ahorro)</strong>
                        </div>
                        <div class="text-end small text-muted" id="resPorcentaje">
                            @Model.PorcentajeAhorro.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)% de descuento
                        </div>
                        <div class="alert alert-info small mt-3 mb-0" id="avisoPrecio">
                            El precio no puede superar la suma de los productos, porque en el cajero se cobran
                            a precio de menú y la diferencia se guarda como descuento.
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a href="/Productos?pestana=promociones" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-modulo">
                            @(Model.EsEdicion ? "Guardar cambios" : "Crear promoción")
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const fmtBs = v => 'Bs ' + Number(v || 0).toLocaleString('es-BO', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        function recalcular() {
            let suma = 0, cantidad = 0;
            document.querySelectorAll('#tablaIncluidos .fila-incluido').forEach(fila => {
                const chk = fila.querySelector('.chk-incluir');
                const cant = parseInt(fila.querySelector('.cantidad-incluir').value || '0', 10);
                const precio = parseFloat(fila.dataset.precio || '0');
                const subtotal = chk.checked ? (cant > 0 ? cant : 0) * precio : 0;
                fila.classList.toggle('seleccionada', chk.checked);
                fila.querySelector('.subtotal-incluido').textContent = fmtBs(subtotal);
                suma += subtotal;
                cantidad += chk.checked ? 1 : 0;
            });

            const precio = parseFloat(document.getElementById('Precio').value || '0');
            const ahorro = suma - precio;
            const pct = suma > 0 && ahorro > 0 ? (ahorro / suma * 100) : 0;

            document.getElementById('resSuma').textContent = fmtBs(suma);
            document.getElementById('resPrecio').textContent = fmtBs(precio);
            document.getElementById('resAhorro').textContent = fmtBs(ahorro);
            document.getElementById('resPorcentaje').textContent =
                pct.toFixed(2).replace('.', ',') + '% de descuento';
            document.getElementById('avisoPrecio').classList.toggle('d-none', ahorro > 0 || suma === 0);
        }

        document.querySelectorAll('.chk-incluir, .cantidad-incluir').forEach(el =>
            el.addEventListener('change', recalcular));
        document.getElementById('Precio').addEventListener('input', recalcular);

        document.getElementById('btnTodos').addEventListener('click', () => {
            const chks = [...document.querySelectorAll('.chk-incluir')];
            const marcar = !chks.every(c => c.checked);
            chks.forEach(c => c.checked = marcar);
            recalcular();
        });

        document.getElementById('formPromocion').addEventListener('submit', () => {
            document.querySelectorAll('#tablaIncluidos .fila-incluido').forEach(fila => {
                const chk = fila.querySelector('.chk-incluir');
                if (!chk.checked) chk.disabled = true;
            });
        });

        // Precios de referencia para el cálculo del resumen
        document.querySelectorAll('#tablaIncluidos .fila-incluido').forEach((fila, i) => {
            const celdas = fila.querySelectorAll('td');
            fila.dataset.precio = celdas[2].textContent.replace(/[^\d.]/g, '');
        });

        recalcular();

        // Vista previa de la imagen elegida antes de guardar
        const inputImagen = document.getElementById('imagenPromocion');
        if (inputImagen) {
            inputImagen.addEventListener('change', () => {
                const archivo = inputImagen.files && inputImagen.files[0];
                const contenedor = document.getElementById('previewPromocionContainer');
                if (!archivo) { contenedor.style.display = 'none'; return; }
                document.getElementById('previewPromocion').src = URL.createObjectURL(archivo);
                contenedor.style.display = 'block';
            });
        }
    </script>
</body>
</html>
