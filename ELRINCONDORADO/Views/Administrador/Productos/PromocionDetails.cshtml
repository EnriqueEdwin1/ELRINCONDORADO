@model ELRINCONDORADO.Models.PromocionDetalleViewModel
@using ELRINCONDORADO.Helpers
@{
    ViewData["Title"] = "Detalle de Promoción";
    Layout = null;
    var promo = Model;
    var nombre = Context.Session.GetString("Nombre");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/marca.css" />
    <link rel="stylesheet" href="~/css/administrador.css" />
</head>
<body class="bg-admin">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h2 class="mb-0">@promo.Nombre</h2>
                <span class="badge-estado @(promo.Estado == "ACTIVA" ? "activo" : "inactivo")">
                    @(promo.Estado == "ACTIVA" ? "Activa" : "Inactiva")
                </span>
            </div>
            <div class="d-flex gap-2">
                <a href="/Administrador" class="btn btn-sm btn-outline-secondary">⌂ Administración</a>
                <a href="/Productos?pestana=promociones" class="btn btn-outline-secondary">Volver</a>
                <a asp-action="PromocionEdit" asp-route-id="@promo.IdPromocion" class="btn btn-modulo">Editar</a>
                <a asp-action="PromocionDelete" asp-route-id="@promo.IdPromocion" class="btn btn-outline-danger">Eliminar</a>
            </div>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="row g-3">
            <div class="col-lg-4">
                <div class="form-card p-3 mb-3">
                    <h5 class="mb-3">Datos</h5>
                    @if (!string.IsNullOrEmpty(promo.ImagenUrl))
                    {
                        <img src="@promo.ImagenUrl" alt="@promo.Nombre" class="img-fluid rounded mb-3" style="max-height: 180px; object-fit: cover;" />
                    }
                    <div class="mb-2">
                        <span class="text-muted d-block">Identificador</span>
                        <strong>#@promo.IdPromocion</strong>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted d-block">Descripción</span>
                        <strong>@(string.IsNullOrWhiteSpace(promo.Descripcion) ? "—" : promo.Descripcion)</strong>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted d-block">Tipo</span>
                        <strong>@promo.Tipo</strong>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted d-block">Vigencia</span>
                        <strong>@(promo.FechaInicio?.ToString("dd/MM/yyyy") ?? "N/A") — @(promo.FechaFin?.ToString("dd/MM/yyyy") ?? "N/A")</strong>
                    </div>
                    <div>
                        <span class="text-muted d-block">En el cajero</span>
                        <strong>
                            @if (promo.Estado == "ACTIVA")
                            {
                                <span>Figura en la pantalla de promociones</span>
                            }
                            else
                            {
                                <span>No aparece en el cajero</span>
                            }
                        </strong>
                    </div>
                </div>

                <div class="form-card p-3">
                    <h5 class="mb-3">Precios</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Productos por separado</span>
                        <strong class="fs-5">@MonedaHelper.FormatearBs(Model.SumaProductos)</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Precio de la promoción</span>
                        <strong class="fs-5">@MonedaHelper.FormatearBs(Model.Precio)</strong>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center">
                        <span>Ahorro</span>
                        <strong class="fs-5 @(Model.TieneAhorro ? "text-success" : "text-danger")">
                            @MonedaHelper.FormatearBs(Model.Ahorro)
                        </strong>
                    </div>
                    @if (Model.TieneAhorro)
                    {
                        <div class="text-end small text-muted">
                            @Model.PorcentajeAhorro.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)% de descuento
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-8">
                <div class="form-card p-3">
                    <h5 class="mb-3">Productos incluidos</h5>
                    @if (Model.Incluidos == null || !Model.Incluidos.Any())
                    {
                        <div class="alert alert-warning mb-0">
                            Esta promoción no tiene productos cargados, así que no se puede vender.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th class="text-center" style="width: 110px;">Cantidad</th>
                                        <th class="text-end" style="width: 130px;">Precio</th>
                                        <th class="text-end" style="width: 130px;">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Incluidos)
                                    {
                                        <tr>
                                            <td>
                                                @item.Nombre
                                                @if (!item.Activo)
                                                {
                                                    <span class="badge-estado inactivo ms-1">Producto inactivo</span>
                                                }
                                            </td>
                                            <td class="text-center">@item.Cantidad</td>
                                            <td class="text-end">@MonedaHelper.FormatearBs(item.Precio)</td>
                                            <td class="text-end">@MonedaHelper.FormatearBs(item.Precio * item.Cantidad)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th colspan="3" class="text-end">Total por separado</th>
                                        <th class="text-end">@MonedaHelper.FormatearBs(Model.SumaProductos)</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
