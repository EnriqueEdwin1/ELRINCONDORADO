@model ELRINCONDORADO.Models.Compra
@using ELRINCONDORADO.Helpers
@{
    ViewData["Title"] = $"Compra Nº {Model.IdCompra:D4}";
    Layout = null;
    var nombre = Context.Session.GetString("Nombre");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/administrador.css" rel="stylesheet" />
    <link href="~/css/crud.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Administrador">🏪 El Rincón Dorado</a>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span class="text-white">@nombre</span>
                <form method="post" action="/Auth/Logout" style="display: inline;">
                    <button type="submit" class="btn btn-logout btn-sm">Cerrar sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container-custom">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-0">Compra Nº @Model.IdCompra.ToString("D4")</h2>
            <div class="d-flex gap-2">
                <a href="/Administrador" class="btn btn-sm btn-outline-secondary">← Volver a administración</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                <a asp-action="Delete" asp-route-id="@Model.IdCompra" class="btn btn-eliminar">Eliminar</a>
                <a asp-action="Comprobante" asp-route-id="@Model.IdCompra" target="_blank" class="btn btn-modulo">Descargar comprobante PDF</a>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-4 mb-3">
                <div class="form-card p-3 h-100">
                    <h6 class="text-muted">Proveedor</h6>
                    <h5 class="mb-1">@Model.Proveedor?.Nombre</h5>
                    <small class="text-muted">@Model.Proveedor?.Telefono</small>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="form-card p-3 h-100">
                    <h6 class="text-muted">Registrada por</h6>
                    <h5 class="mb-1">@(Model.Empleado != null ? $"{Model.Empleado.Nombre} {Model.Empleado.Apellido}" : "—")</h5>
                    <small class="text-muted">@Model.Empleado?.Usuario</small>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="form-card p-3 h-100">
                    <h6 class="text-muted">Fecha y estado</h6>
                    <h5 class="mb-1">@Model.FechaCompra.ToString("dd/MM/yyyy HH:mm")</h5>
                    <span class="badge-estado activo">@Model.Estado</span>
                </div>
            </div>
        </div>

        <table class="table table-crud">
            <thead>
                <tr>
                    <th>Insumo</th>
                    <th>Cantidad</th>
                    <th>Costo Unitario</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detalle in Model.DetallesCompras)
                {
                    <tr>
                        <td>@detalle.Insumo?.Nombre</td>
                        <td>@MonedaHelper.FormatearNumero(detalle.Cantidad) @detalle.Insumo?.UnidadMedida</td>
                        <td>@MonedaHelper.FormatearBs(detalle.CostoUnitario)</td>
                        <td>@MonedaHelper.FormatearBs(detalle.Subtotal)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-end fw-bold">Subtotal</td>
                    <td class="fw-bold">@MonedaHelper.FormatearBs(Model.Subtotal)</td>
                </tr>
                <tr>
                    <td colspan="3" class="text-end fw-bold">Descuento</td>
                    <td class="fw-bold text-danger">- @MonedaHelper.FormatearBs(Model.Descuento)</td>
                </tr>
                <tr class="table-warning">
                    <td colspan="3" class="text-end fw-bold">Total</td>
                    <td class="fw-bold">@MonedaHelper.FormatearBs(Model.Total)</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>