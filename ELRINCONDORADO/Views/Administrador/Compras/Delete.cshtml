@model ELRINCONDORADO.Models.Compra
@using ELRINCONDORADO.Helpers
@{
    ViewData["Title"] = "Eliminar Compra";
    Layout = null;
    var nombre = Context.Session.GetString("Nombre");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/administrador.css" rel="stylesheet" />
    <link href="~/css/crud.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Administrador">🏪 El Rincón Dorado</a>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span class="text-white">@nombre</span>
                <form method="post" action="/Auth/Logout" style="display: inline;">
                    <button type="submit" class="btn btn-logout btn-sm">Cerrar sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container-custom">
        <div class="form-card text-center">
            <h2>Eliminar Compra</h2>
            <p class="mb-1">¿Estás seguro de que deseas eliminar la compra <strong>Nº @Model.IdCompra.ToString("D4")</strong>?</p>
            <p class="text-muted mb-1"><strong>@Model.Proveedor?.Nombre</strong> — @Model.FechaCompra.ToString("dd/MM/yyyy HH:mm")</p>
            <p class="text-muted mb-4">Total: <strong>@MonedaHelper.FormatearBs(Model.Total)</strong></p>

            <div class="alert alert-warning">
                Se revertirá el stock de los <strong>@(Model.DetallesCompras?.Count ?? 0)</strong> insumo(s)
                y se eliminarán los movimientos de inventario asociados.
            </div>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="IdCompra" />
                <button type="submit" class="btn btn-eliminar w-100 mb-2">Sí, eliminar</button>
                <a asp-action="Index" class="btn btn-link w-100">Cancelar</a>
            </form>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>