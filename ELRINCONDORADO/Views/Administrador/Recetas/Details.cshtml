@model ELRINCONDORADO.Models.Receta
@using ELRINCONDORADO.Helpers
@{
    ViewData["Title"] = "Detalle de Receta";
    Layout = null;
    var nombre = Context.Session.GetString("Nombre");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/administrador.css" rel="stylesheet" />
    <link href="~/css/crud.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Administrador">🏪 El Rincón Dorado</a>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span class="text-white">@nombre</span>
                <form method="post" action="/Auth/Logout" style="display: inline;">
                    <button type="submit" class="btn btn-logout btn-sm">Cerrar sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container-custom">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-0">@Model.Producto?.Nombre (@Model.IdReceta.ToString("D4"))</h2>
            <div class="d-flex gap-2">
                <a href="/Administrador" class="btn btn-sm btn-outline-secondary">← Volver a administración</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                <a asp-action="Edit" asp-route-id="@Model.IdReceta" class="btn btn-modulo">Editar</a>
                <a asp-action="Delete" asp-route-id="@Model.IdReceta" class="btn btn-eliminar">Eliminar</a>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-4 mb-3">
                <div class="form-card p-3 h-100">
                    <h6 class="text-muted">Producto</h6>
                    <h5 class="mb-1">@Model.Producto?.Nombre</h5>
                    <small class="text-muted">Producto Nº @((Model.IdProducto).ToString("D4"))</small>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="form-card p-3 h-100">
                    <h6 class="text-muted">Descripción</h6>
                    <p class="mb-0">@(string.IsNullOrEmpty(Model.Descripcion) ? "—" : Model.Descripcion)</p>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="form-card p-3 h-100">
                    <h6 class="text-muted">Estado</h6>
                    <span class="badge-estado @(Model.Activo ? "activo" : "inactivo")">
                        @(Model.Activo ? "ACTIVA" : "INACTIVA")
                    </span>
                </div>
            </div>
        </div>

        <div class="form-card p-3">
            <h5 class="mb-3">Insumos de la receta (@(Model.DetalleRecetas?.Count ?? 0))</h5>
            <table class="table table-crud">
                <thead>
                    <tr>
                        <th>Insumo</th>
                        <th>Cantidad</th>
                        <th>Unidad de medida</th>
                        <th>Costo unitario</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DetalleRecetas != null && Model.DetalleRecetas.Any())
                    {
                        @foreach (var detalle in Model.DetalleRecetas)
                        {
                            <tr>
                                <td>@detalle.Insumo?.Nombre</td>
                                <td>@MonedaHelper.FormatearNumero(detalle.Cantidad)</td>
                                <td>@detalle.UnidadMedida</td>
                                <td>@MonedaHelper.FormatearBs(detalle.Insumo?.CostoUnitario ?? 0)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">La receta no tiene insumos cargados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
