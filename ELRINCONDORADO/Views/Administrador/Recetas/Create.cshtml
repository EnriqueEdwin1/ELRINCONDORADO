@model ELRINCONDORADO.Models.RecetaViewModel
@{
    ViewData["Title"] = "Nueva Receta";
    Layout = null;
    var nombre = Context.Session.GetString("Nombre");
    var insumosJson = System.Text.Json.JsonSerializer.Serialize(
        ((IEnumerable<ELRINCONDORADO.Models.Insumo>)ViewBag.Insumos)
        .Select(i => new { i.IdInsumo, i.Nombre, i.UnidadMedida }));
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/administrador.css" rel="stylesheet" />
    <link href="~/css/crud.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Administrador">🏪 El Rincón Dorado</a>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span class="text-white">@nombre</span>
                <form method="post" action="/Auth/Logout" style="display: inline;">
                    <button type="submit" class="btn btn-logout btn-sm">Cerrar sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container-custom">
        <div class="form-card form-card-wide">
            <h2>Nueva Receta</h2>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label class="form-label">Producto</label>
                    <select name="IdProducto" class="form-control" asp-items="ViewBag.IdProducto" required>
                        <option value="">Seleccionar producto...</option>
                    </select>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Descripción</label>
                    <textarea name="Descripcion" class="form-control" rows="3" placeholder="Describí la receta y su preparación"></textarea>
                </div>

                <div class="form-group mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label mb-0">Insumos de la receta</label>
                        <button type="button" class="btn btn-sm btn-modulo btn-agregar">+ Agregar insumo</button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-crud detalle-table" id="tablaDetalles">
                            <thead>
                                <tr>
                                    <th style="min-width: 220px;">Insumo</th>
                                    <th style="min-width: 110px;">Cantidad</th>
                                    <th style="min-width: 130px;">Unidad de medida</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <div class="text-danger" id="errorDetalles" style="display: none;">Agrega al menos un insumo con cantidad mayor a cero.</div>
                </div>

                <div class="form-group mb-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="Activo" value="true" checked />
                        <label class="form-check-label" for="Activo">Receta activa</label>
                    </div>
                </div>

                <button type="submit" class="btn btn-guardar">Guardar receta</button>
                <a asp-action="Index" class="btn btn-cancelar mt-2 text-center">Cancelar</a>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        var insumos = @Html.Raw(insumosJson);
        var indice = 0;

        function opcionesInsumo(seleccionado) {
            var usados = [];
            $('#tablaDetalles tbody tr').each(function () {
                var v = parseInt($(this).find('.f-IdInsumo').val()) || 0;
                if (v && v !== seleccionado && usados.indexOf(v) === -1) usados.push(v);
            });
            var opciones = '<option value="">Seleccionar...</option>';
            insumos.forEach(function (i) {
                if (usados.indexOf(i.IdInsumo) !== -1) return;
                var sel = seleccionado === i.IdInsumo ? ' selected' : '';
                opciones += '<option value="' + i.IdInsumo + '"' + sel + '>' + i.Nombre + ' (' + i.UnidadMedida + ')</option>';
            });
            return opciones;
        }

        function refrescarOpciones() {
            $('#tablaDetalles tbody tr').each(function () {
                var fila = $(this);
                var actual = parseInt(fila.find('.f-IdInsumo').val()) || 0;
                fila.find('.f-IdInsumo').html(opcionesInsumo(actual));
            });
        }

        function renumerar() {
            $('#tablaDetalles tbody tr').each(function (i, fila) {
                $(fila).find('.f-IdInsumo').attr('name', 'Detalles[' + i + '].IdInsumo');
                $(fila).find('.f-Cantidad').attr('name', 'Detalles[' + i + '].Cantidad');
                $(fila).find('.f-UnidadMedida').attr('name', 'Detalles[' + i + '].UnidadMedida');
            });
        }

        function agregarFila() {
            var fila = '<tr>' +
                '<td><select class="form-control f-IdInsumo" required>' + opcionesInsumo() + '</select></td>' +
                '<td><input type="number" class="form-control f-Cantidad" min="0" step="any" placeholder="0" required /></td>' +
                '<td><input type="text" class="form-control f-UnidadMedida" readonly placeholder="Auto" /></td>' +
                '<td><button type="button" class="btn btn-sm btn-eliminar btn-quitar">✕</button></td>' +
                '</tr>';
            $('#tablaDetalles tbody').append(fila);
            renumerar();
            refrescarOpciones();
        }

        $(document).on('change', '.f-IdInsumo', function () {
            var id = parseInt($(this).val()) || 0;
            var insumo = insumos.find(function (i) { return i.IdInsumo === id; });
            if (insumo) {
                $(this).closest('tr').find('.f-UnidadMedida').val(insumo.UnidadMedida);
            }
            refrescarOpciones();
        });

        $(document).on('click', '.btn-agregar', function () {
            var hayVacio = false;
            $('#tablaDetalles tbody tr').each(function () {
                if (!$(this).find('.f-IdInsumo').val()) hayVacio = true;
            });
            if (!hayVacio) agregarFila();
        });

        $(document).on('click', '.btn-quitar', function () {
            $(this).closest('tr').remove();
            renumerar();
            refrescarOpciones();
        });

        $(document).on('submit', 'form', function () {
            var valido = false;
            $('#tablaDetalles tbody tr').each(function () {
                var cantidad = parseFloat($(this).find('.f-Cantidad').val()) || 0;
                if ($(this).find('.f-IdInsumo').val() && cantidad > 0) valido = true;
            });
            if (!valido) {
                $('#errorDetalles').show();
                return false;
            }
            $('#errorDetalles').hide();
            return true;
        });

        $(function () {
            agregarFila();
        });
    </script>
</body>
</html>
